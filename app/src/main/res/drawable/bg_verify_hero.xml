<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Frosted glass outer ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#38FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#80FFFFFF" />
            <size
                android:width="96dp"
                android:height="96dp" />
        </shape>
    </item>
    <!-- Soft blue core -->
    <item
        android:bottom="14dp"
        android:left="14dp"
        android:right="14dp"
        android:top="14dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:endColor="@color/soft_blue"
                android:startColor="@color/blue_100" />
        </shape>
    </item>
</layer-list>
<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <!-- Top Navigation App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/sellerAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <!-- Back Action -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@color/white"
                android:clickable="true"
                android:contentDescription="Back"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeColor="@color/grey_200"
                app:strokeWidth="1dp"
                app:tint="@color/airbnb_ink" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:letterSpacing="-0.01"
                android:text="@string/seller_profile_title"
                android:textColor="@color/airbnb_ink"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- Report User Action -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/btnReportUser"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@color/white"
                android:clickable="true"
                android:contentDescription="Report user"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="9dp"
                android:src="@drawable/ic_report"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeColor="@color/grey_200"
                app:strokeWidth="1dp"
                app:tint="@color/airbnb_muted" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/grey_200" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Scrollable Profile Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/profileScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="24dp"
            android:paddingBottom="48dp">

            <!-- ============ HERO HEADER (Social Media Style) ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- Avatar with verified badge -->
                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivSellerAvatar"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@color/soft_blue"
                        android:contentDescription="@string/seller_avatar"
                        android:padding="24dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_user_line"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                        app:strokeColor="@color/grey_200"
                        app:strokeWidth="1.5dp"
                        app:tint="@color/pks_blue"
                        tools:src="@drawable/ic_user_line" />

                    <ImageView
                        android:id="@+id/ivVerifiedBadge"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_verified_badge"
                        android:contentDescription="@string/seller_verified_pill"
                        android:padding="3dp"
                        android:src="@drawable/ic_verified"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </FrameLayout>

                <!-- Name -->
                <TextView
                    android:id="@+id/tvSellerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:letterSpacing="-0.02"
                    android:maxWidth="320dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/airbnb_ink"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    tools:text="Amirul Farhan" />

                <!-- Verified / Role Pill -->
                <TextView
                    android:id="@+id/tvSellerBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_role_chip"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.04"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4.5dp"
                    android:text="@string/seller_verified_pill"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Bio -->
                <TextView
                    android:id="@+id/tvSellerBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textColor="@color/airbnb_muted"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="Sells books &amp; gadgets. Quick meetups at Blok A every weekday."
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Action Buttons: Follow + Message -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFollow"
                    style="@style/Widget.PolyGo.Button"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/pks_blue"
                    android:text="@string/seller_follow"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_heart_outline"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMessageSeller"
                    style="@style/Widget.PolyGo.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/seller_message"
                    android:textAllCaps="false"
                    android:textColor="@color/pks_blue"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_email"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/pks_blue"
                    app:strokeColor="@color/pks_blue"
                    app:strokeWidth="1.2dp" />
            </LinearLayout>

            <!-- Stats Bar -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/statsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/grey_200"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <!-- Rating Metric -->
                    <LinearLayout
                        android:id="@+id/statRating"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="14dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvSellerRating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="-0.01"
                                android:textColor="@color/airbnb_ink"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="4.9" />

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginStart="3dp"
                                android:contentDescription="@string/profile_star_icon"
                                android:src="@drawable/ic_star_filled"
                                app:tint="@color/pks_blue" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/seller_rating_label"
                            android:textColor="@color/airbnb_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="34dp"
                        android:background="@color/grey_200" />

                    <!-- Sold Metric -->
                    <LinearLayout
                        android:id="@+id/statSold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="14dp">

                        <TextView
                            android:id="@+id/tvItemsSold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="-0.01"
                            android:textColor="@color/airbnb_ink"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="28" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/profile_items_sold"
                            android:textColor="@color/airbnb_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="34dp"
                        android:background="@color/grey_200" />

                    <!-- Green Impact Metric -->
                    <LinearLayout
                        android:id="@+id/statImpact"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="14dp">

                        <TextView
                            android:id="@+id/tvGreenImpact"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="-0.01"
                            android:text="@string/profile_top_15_percent"
                            android:textColor="@color/airbnb_ink"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="Top 15%" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/seller_green_impact"
                            android:textColor="@color/airbnb_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Private Account Notice -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/privateCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:visibility="gone"
                app:cardBackgroundColor="#F8FBFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/soft_blue"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/seller_private_title"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/pks_blue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/seller_private_title"
                        android:textColor="@color/airbnb_ink"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/seller_private_desc"
                        android:textColor="@color/airbnb_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= SECTION 1: LISTINGS ================= -->
            <LinearLayout
                android:id="@+id/headerListings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="-0.01"
                    android:text="@string/seller_active_listings"
                    android:textColor="@color/airbnb_ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvListingsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_count_pill"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/pks_blue"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="6" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/profile_chevron"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/airbnb_muted" />
            </LinearLayout>

            <!-- Recycler Grid of Seller Products -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSellerListings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2"
                tools:itemCount="2"
                tools:listitem="@layout/item_product_card" />

            <!-- Empty Listings Feedback Placeholder -->
            <include
                android:id="@+id/emptyListings"
                layout="@layout/layout_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                tools:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="20dp"
                android:background="@color/grey_200" />

            <!-- ================= SECTION 2: REVIEWS ================= -->
            <LinearLayout
                android:id="@+id/headerReviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="-0.01"
                    android:text="@string/seller_campus_reviews"
                    android:textColor="@color/airbnb_ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReviewsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_count_pill"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/pks_blue"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="4" />
            </LinearLayout>

            <!-- Rate the Seller (verified buyers only) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddReview"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:text="@string/seller_write_review"
                android:textAllCaps="false"
                android:textColor="@color/pks_blue"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_star_outline"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:iconTint="@color/pks_blue" />

            <!-- Review Items Container -->
            <LinearLayout
                android:id="@+id/reviewList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <!-- Empty Reviews Feedback Placeholder -->
            <include
                android:id="@+id/emptyReviews"
                layout="@layout/layout_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                tools:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

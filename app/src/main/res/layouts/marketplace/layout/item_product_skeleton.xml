<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#EAECEF"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <!-- Ghost Image Area -->
        <!-- Retains the 1:1 or 4:3 style aspect ratio for product grids -->
        <View
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="#F2F4F7" />

        <!-- Ghost Text Content Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="14dp">

            <!-- Title Line 1 (Longer) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginEnd="24dp"
                app:cardBackgroundColor="#F2F4F7"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp" />

            <!-- Title Line 2 (Shorter, to simulate natural text wrapping) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="64dp"
                app:cardBackgroundColor="#F2F4F7"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp" />

            <!-- Metadata Row (e.g., Rating, Location) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="80dp"
                android:layout_height="12dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#F2F4F7"
                app:cardCornerRadius="6dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp" />

            <!-- Price Row (Slightly thicker to mimic bold text) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="90dp"
                android:layout_height="22dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#F2F4F7"
                app:cardCornerRadius="11dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
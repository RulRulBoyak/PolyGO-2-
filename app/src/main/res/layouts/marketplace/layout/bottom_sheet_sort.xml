<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="40dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@color/grey_200"
        android:backgroundTint="@color/grey_200" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sort by"
        android:textColor="@color/airbnb_ink"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Find what you need faster"
        android:textColor="@color/airbnb_muted"
        android:textSize="14sp" />

    <RadioGroup
        android:id="@+id/radioGroupSort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <RadioButton
            android:id="@+id/optionNewest"
            style="@style/Widget.Material3.CompoundButton.RadioButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_sort_option"
            android:button="@null"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:tag="newest"
            android:text="Newest First"
            android:textColor="@color/sort_option_text"
            android:textSize="15sp"
            app:drawableEndCompat="@drawable/ic_sort_check" />

        <RadioButton
            android:id="@+id/optionPriceLow"
            style="@style/Widget.Material3.CompoundButton.RadioButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_sort_option"
            android:button="@null"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:tag="price_low"
            android:text="Price: Low to High"
            android:textColor="@color/sort_option_text"
            android:textSize="15sp"
            app:drawableEndCompat="@drawable/ic_sort_check" />

        <RadioButton
            android:id="@+id/optionPriceHigh"
            style="@style/Widget.Material3.CompoundButton.RadioButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_sort_option"
            android:button="@null"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:tag="price_high"
            android:text="Price: High to Low"
            android:textColor="@color/sort_option_text"
            android:textSize="15sp"
            app:drawableEndCompat="@drawable/ic_sort_check" />

        <RadioButton
            android:id="@+id/optionOldest"
            style="@style/Widget.Material3.CompoundButton.RadioButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_sort_option"
            android:button="@null"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:tag="oldest"
            android:text="Oldest First"
            android:textColor="@color/sort_option_text"
            android:textSize="15sp"
            app:drawableEndCompat="@drawable/ic_sort_check" />

    </RadioGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApplySort"
        style="@style/Widget.PolyGo.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:text="Apply Sorting"
        app:cornerRadius="16dp" />

</LinearLayout>

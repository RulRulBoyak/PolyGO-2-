<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PolyGo" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/airbnb_coral</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/airbnb_ink</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/airbnb_ink</item>
        <item name="colorSurfaceVariant">@color/surface_variant_light</item>
        <item name="colorOnSurfaceVariant">@color/airbnb_muted</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:textColorPrimary">@color/airbnb_ink</item>
        <item name="android:textColorSecondary">@color/airbnb_muted</item>
        <item name="materialButtonStyle">@style/Widget.PolyGo.Button</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.PolyGo.MaterialAlertDialog</item>
    </style>

    <style name="Theme.PolyGo" parent="Base.Theme.PolyGo">
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo_polygo</item>
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="postSplashScreenTheme">@style/Theme.PolyGo</item>
    </style>

    <style name="Widget.PolyGo.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/airbnb_border</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <style name="Widget.PolyGo.PrimaryGradientButton" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/airbnb_coral</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PolyGo.Button</item>
    </style>

    <style name="Widget.PolyGo.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/button_primary_background</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PolyGo.Button</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.PolyGo.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/pks_blue</item>
        <item name="android:textColor">@color/button_tonal_text</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PolyGo.Button</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.PolyGo.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/button_tonal_background</item>
        <item name="android:textColor">@color/button_tonal_text</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PolyGo.Button</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.PolyGo.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/button_tonal_text</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PolyGo.Button</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.PolyGo.Button.Destructive" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/semantic_error</item>
        <item name="android:textColor">@color/white</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PolyGo.Button</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ThemeOverlay.PolyGo.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.PolyGo.Dialog</item>
        <item name="colorSurface">@color/white</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.PolyGo.Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.PolyGo.Dialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.PolyGo.DialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.PolyGo.DialogButton.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.PolyGo.DialogButton.Text</item>
        <item name="android:backgroundDimAmount">0.42</item>
    </style>

<style name="TextAppearance.PolyGo.Dialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.PolyGo.Dialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Widget.PolyGo.DialogButton.Positive" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/pks_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PolyGo.Button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">80dp</item>
    </style>

    <style name="Widget.PolyGo.DialogButton.Text" parent="Widget.Material3.Button.TextButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/pks_blue</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PolyGo.Button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <style name="ShapeAppearance.PolyGo.Button" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearance.PolyGo.Dialog" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Widget.PolyGo.BentoCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/airbnb_border</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <!-- Bottom Navigation Custom Style -->
    <style name="Widget.PolyGo.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemIconSize">22dp</item>
        <item name="itemPaddingTop">16dp</item>
        <item name="itemPaddingBottom">12dp</item>
        <!-- This Material version has no enabled flag; a transparent indicator
             avoids the extra rectangular selected layer. -->
        <item name="itemActiveIndicatorStyle">@style/Widget.PolyGo.BottomNavigation.ActiveIndicator</item>
        <item name="itemRippleColor">@android:color/transparent</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.PolyGo.BottomNav</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.PolyGo.BottomNav.Active</item>
    </style>

    <style name="TextAppearance.PolyGo.BottomNav" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.PolyGo.BottomNav.Active" parent="TextAppearance.PolyGo.BottomNav">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.PolyGo.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="ShapeAppearance.PolyGo.CardImage" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.PolyGo.CardImage.Large" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearance.PolyGo.ProductImage" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>

    <style name="ShapeAppearance.PolyGo.Circle" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.PolyGo.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="android:textColor">@drawable/selector_chip_filter_text</item>
        <item name="chipBackgroundColor">@drawable/selector_chip_filter_bg</item>
        <item name="chipStrokeColor">@drawable/selector_chip_filter_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipIconTint">@drawable/selector_chip_filter_icon</item>
        <item name="chipIconSize">18dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="rippleColor">?attr/colorPrimary</item>
    </style>

    <style name="Widget.PolyGo.Chip.Tag" parent="Widget.PolyGo.Chip.Filter">
        <item name="android:textColor">@color/airbnb_ink</item>
        <item name="chipBackgroundColor">@color/surface_variant_light</item>
        <item name="chipStrokeColor">@color/grey_200</item>
        <item name="chipIconTint">@color/pks_blue</item>
        <item name="chipIconSize">16dp</item>
        <item name="chipMinHeight">34dp</item>
    </style>

    <style name="Theme.PolyGo.ProfileCrop" parent="Theme.PolyGo">
        <item name="android:windowBackground">#101114</item>
        <item name="android:navigationBarColor">#101114</item>
        <item name="android:statusBarColor">#101114</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>

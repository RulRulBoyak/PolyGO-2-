<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive local store from Google Drive backup -->
        <exclude domain="sharedpref" path="polygo_local_store.xml"/>
        <!-- Exclude chat/listings database (contains personal/sensitive data) -->
        <exclude domain="database" path="polygo.db"/>
        <exclude domain="database" path="polygo.db-wal"/>
        <exclude domain="database" path="polygo.db-shm"/>
    </cloud-backup>
    <device-transfer>
        <!-- Allow session transfer between devices during setup for convenience,
             but keep it restricted if you prefer maximum security -->
        <include domain="sharedpref" path="polygo_local_store.xml"/>
    </device-transfer>
</data-extraction-rules>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="32dp"
    android:paddingVertical="48dp">

    <!-- Hero Illustration Container -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <!-- High-End Vector Animation (Phase 6) -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/emptyLottie"
            android:layout_width="220dp"
            android:layout_height="220dp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_speed="0.8"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/bg_category_circle"
            android:backgroundTint="@color/soft_blue">

            <ImageView
                android:id="@+id/emptyIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:contentDescription="Empty State Graphic"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/pks_blue" />
        </FrameLayout>
    </FrameLayout>

    <!-- Main Headline -->
    <TextView
        android:id="@+id/emptyTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:letterSpacing="-0.02"
        android:text="Nothing here yet"
        android:textColor="?attr/colorOnSurface"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Descriptive Sub-text -->
    <TextView
        android:id="@+id/emptySubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="When there is something to show, it will appear here."
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14.5sp" />

    <!-- Primary Action Button (Dynamically toggled via Java) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/emptyAction"
        style="@style/Widget.PolyGo.Button"
        android:layout_width="wrap_content"
        android:layout_height="54dp"
        android:layout_marginTop="28dp"
        android:letterSpacing="0.01"
        android:minWidth="200dp"
        android:text="Explore campus"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/pks_blue"
        app:cornerRadius="16dp"
        app:elevation="0dp" />

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/tvErrorEmoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📡"
        android:textSize="48sp" />

    <TextView
        android:id="@+id/tvErrorTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="No internet connection"
        android:textColor="@color/airbnb_ink"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvErrorBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Check Wi-Fi or start XAMPP, then try again."
        android:textColor="@color/airbnb_muted" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRetry"
        style="@style/Widget.PolyGo.Button"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:minWidth="160dp"
            android:text="Retry"
            android:textAllCaps="false" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinueOffline"
        style="@style/Widget.PolyGo.Button.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:minWidth="160dp"
        android:text="Continue with saved data"
        android:textAllCaps="false" />
</LinearLayout>

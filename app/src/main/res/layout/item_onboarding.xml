<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <!-- Hero Graphic Container -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_category_circle"
            android:backgroundTint="@color/soft_blue">

            <TextView
                android:id="@+id/tvOnboardEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="54sp"
                tools:text="📚" />
        </FrameLayout>

        <!-- Slide Title -->
        <TextView
            android:id="@+id/tvOnboardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:letterSpacing="-0.02"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="@color/airbnb_ink"
            android:textStyle="bold"
            tools:text="Buy and Sell Locally" />

        <!-- Slide Description -->
        <TextView
            android:id="@+id/tvOnboardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/airbnb_muted"
            android:textSize="15sp"
            tools:text="Find textbooks, electronics, and verified services right here on the PKS campus. Safe, fast, and student-first." />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>